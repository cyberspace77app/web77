# CyberSpace77 ─── dynamic url handling
# Install the app in the root directory for dynamic urls to work
# /@username
# /@username/permlink
# /subspace/121566  /subspace/121566/trending|hot|about|members|edit
# /c/hive-121566  /c/hive-121566/latest|trending|hot|about|members|edit
# /121566 redirects to /subspace/121566
# /trending  /hot  /created  /search  /search/spaces  /search/subspaces  /spaces  /subspaces  /subspaces/browse  /subspaces/newest  /subspaces/create  /welcome  /imprint  /settings  /settings/profile  /settings/nodes
# /space/tag  /latest/tag  /created/tag  /trending/tag  /hot/tag
#
# Social media or messenger link-preview crawlers do not run the app, so they only see index.html.
# Those user agents get crawler.php, which pre-fetches the title and Open Graph tags.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteCond %{HTTP_USER_AGENT} "(facebookexternalhit|Twitterbot|TelegramBot|WhatsApp|Discordbot|Slackbot|Slack-ImgProxy|LinkedInBot|Pinterest|redditbot|Embedly|Iframely|vkShare|MicrosoftPreview|BingPreview|Viber|Tumblr|Snapchat|Mastodon|Akkoma|Pleroma|Misskey|Bluesky|bitlybot|kakaotalk-scrap|FlipboardProxy|GoogleMessages|Quora Link Preview|Yahoo Link Preview|outbrain|rogerbot)" [NC]
  RewriteRule ^ /crawler.php [QSA,L]

  RewriteRule ^ /index.html [QSA,L]
</IfModule>

<IfModule mod_dir.c>
  DirectoryIndex index.html
</IfModule>

<IfModule mod_headers.c>
  Header merge Vary User-Agent
</IfModule>
